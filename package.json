{
  "name": "@bemedev/app-monorepo",
  "private": true,
  "description": "A reprogramming method to code better",
  "keywords": [
    "state machines",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "type": "module",
  "scripts": {
    "pnpm:devPreinstall": "node -e \"const fs=require('fs'); const pkg=JSON.parse(fs.readFileSync('./package.json')); const version=require('child_process').execSync('pnpm -v').toString().trim(); pkg.packageManager='pnpm@' + version; fs.writeFileSync('./package.json', JSON.stringify(pkg, null, 2) + '\\n');\"",
    "build": "pnpm -r --sort --sequential run build",
    "config": "pnpm i",
    "rimraf": "pnpx rimraf -rf",
    "rinit": "pnpm run rm && pnpm run config",
    "lint": "pnpm run -r lint",
    "test": "pnpm run -r test",
    "pretest": "pnpm run -r pretest",
    "posttest": "pnpm run -r posttest",
    "test:only": "pnpm run -r test:only",
    "_ci": "pnpm run -r --sort --sequential _ci",
    "ci": "CI=$(date +%s) pnpm install && pnpm run _ci && echo \"\n✅ CI takes $(($(date +%s) - CI))s\n\"",
    "ci:admin": "CI_ADMIN=$(date +%s) && pnpm run rm && pnpm run up && pnpm install && pnpm run _ci && echo \"\n✅ Admin CI takes $(($(date +%s) - CI_ADMIN))s\n\"",
    "rm": "pnpm run rimraf -- node_modules pnpm-lock.yaml && pnpm clean lockfile",
    "up": "pnpm -r update --latest !typescript && pnpm run check-updates",
    "check-updates": "pnpm dlx npm-check-updates -w -u --dep peer,optional,prod",
    "prepare": "husky"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "^1.1.1",
    "@bemedev/rolldown-config": "^0.5.0",
    "@bemedev/sleep": "^0.2.2",
    "@bemedev/typings": "^1.3.0",
    "@types/clone-deep": "^4.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "onchange": "^7.1.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "1.2.1",
    "tsc-alias": "^1.9.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
