{
  "name": "@bemedev/app-monorepo",
  "private": true,
  "description": "A reprogramming method to code better",
  "keywords": [
    "state machines",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "type": "module",
  "scripts": {
    "ci": "CIN=$(date +%s) && vp install  && vp run pretest && vp run lint && vp run test:only && vp run posttest && echo \"\n✅ CI takes $(($(date +%s) - CIN))s\n\"",
    "ci:admin": "FULL_CI=$(date +%s) && pnpm run rm && pnpm run up && vp run ci && echo \"\n✅ Full CI takes $(($(date +%s) - FULL_CI))s\n\"",
    "pnpm:devPreinstall": "node -e \"const fs=require('fs'); const pkg=JSON.parse(fs.readFileSync('./package.json')); const version=require('child_process').execSync('pnpm -v').toString().trim(); pkg.packageManager='pnpm@' + version; fs.writeFileSync('./package.json', JSON.stringify(pkg, null, 2) + '\\n');\"",
    "config": "vp i",
    "rinit": "vp run rm && vp run config",
    "fmt": "vp fmt",
    "test": "vp test",
    "pretest": "vp run -r pretest",
    "posttest": "vp run size",
    "rm": "pnpm clean --lockfile --yes",
    "up": "vp update --latest && vp run check-updates",
    "check-updates": "vp dlx npm-check-updates -w -u --dep dev,peer,optional,prod",
    "rm:lib": "pnpm run -r rm:lib",
    "generate:lib": "vp run -r generate:lib",
    "prepare": "husky"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "^1.5.2",
    "@bemedev/sleep": "^0.2.2",
    "@bemedev/typings": "^1.5.0",
    "@size-limit/file": "^14.3.0",
    "@types/clone-deep": "^4.0.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "fast-glob": "^3.3.3",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "onchange": "^7.1.0",
    "pretty-quick": "^4.2.2",
    "size-limit": "^14.3.0",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
