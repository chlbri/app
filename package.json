{
  "name": "@bemedev/app",
  "version": "0.1.5",
  "description": "A reprogramming method to code better",
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./utils": {
      "import": "./lib/utils/index.js",
      "require": "./lib/utils/index.js",
      "types": "./lib/utils/index.d.ts"
    },
    "./types": {
      "import": [
        "./lib/types/index.js"
      ],
      "require": "./lib/types/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./bemedev-types": {
      "types": "./lib/libs/bemedev/globals/types.d.ts"
    },
    "./constants": {
      "import": "./lib/constants/index.js",
      "require": "./lib/constants/index.js",
      "types": "./lib/constants/index.d.ts"
    }
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "keywords": [
    "typescript",
    "state machines"
  ],
  "files": [
    "lib",
    "public"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm rm:lib && pnpm run rolldown",
    "_ci": "pnpm run config:off && pnpm run lint && pnpm run test",
    "ci": "CI_START=$(date +%s) && pnpm run _ci && pnpm run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "ci:admin": "CI_START=$(date +%s) && pnpm run rm && pnpm run upgrade:fast && pnpm run _ci && echo \"\n✅ Admin CI takes $(($(date +%s) - CI_START))s\n\"",
    "config": "pnpm install",
    "config:off": "pnpm run config --offline",
    "generate": "pnpm dlx @bemedev/app-cli generate -o ./src/__tests__/app.gen.ts",
    "generate:watch": "pnpm dlx @bemedev/app-cli watch -o ./src/__tests__/app.gen.ts",
    "_lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "lint:watch": "onchange --await-write-finish 1500 -d 10000 -v \"**/*.ts\" -- pnpm run lint",
    "build:watch": "onchange --await-write-finish 1500 -d 10000 -v \"**/*.ts\" -- pnpm run build",
    "p-q": "pretty-quick",
    "posttest": "pnpm run fmt",
    "prepare": "husky",
    "prepublishOnly": "",
    "pretest": "pnpm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "rinit": "pnpm clean --lockfile && pnpm run rm && pnpm run config",
    "rinit:off": "pnpm run rm && pnpm run config:off",
    "rm": "pnpx rimraf ./node_modules ./pnpm-lock.yaml",
    "rm:lib": "pnpx rimraf ./lib",
    "rolldown": "rolldown -c",
    "test:coverage": "vitest run",
    "test": "pnpm run test:coverage",
    "test:no-type": "pnpm run test:coverage -c \"vitest.config.notype.ts\" --no-coverage",
    "test:only": "pnpm run test:coverage --no-coverage",
    "test:ui": "vitest --ui",
    "test:type": "pnpm run test:coverage -c \"vitest.config.type.ts\" --no-coverage",
    "test:type:watch": "vitest -c \"vitest.config.type.ts\"",
    "test:watch": "vitest",
    "upgrade": "pnpm dlx @bemedev/upgrade-npm-package",
    "upgrade:fast": "pnpm up --latest"
  },
  "devDependencies": {
    "@bemedev/app-cli": "^0.2.2",
    "@bemedev/build-tests": "^0.1.2",
    "@bemedev/dev-utils": "^0.7.0",
    "@bemedev/fsf": "^1.0.1",
    "@bemedev/rolldown-config": "^0.5.0",
    "@bemedev/rx-pausable": "^1.2.0",
    "@bemedev/sequence": "^0.1.0",
    "@types/clone-deep": "^4.0.4",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "add": "^2.0.6",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "is-online": "^12.0.2",
    "onchange": "^7.1.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "1.0.3",
    "rxjs": "^7.8.2",
    "tsc-alias": "^1.8.17",
    "tslib": "^2.8.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "valibot": "^1.4.1",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@bemedev/better-promise": "^0.1.1",
    "@bemedev/better-set": "^0.2.1",
    "@bemedev/boolean-recursive": "^0.0.3",
    "@bemedev/decompose": "^2.2.0",
    "@bemedev/interval2": "^1.0.1",
    "@bemedev/pipe": "^1.6.1",
    "@bemedev/scheduler": "^1.0.0",
    "@bemedev/sleep": "^0.2.2",
    "@bemedev/typings": "^1.2.0",
    "clone-deep": "^4.0.1",
    "cmd-ts": "^0.15.0",
    "deepmerge-ts": "^7.1.5",
    "fast-deep-equal": "^3.1.3",
    "nanoid": "^5.1.11"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f"
}
