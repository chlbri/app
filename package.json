{
  "name": "@bemedev/app-monorepo",
  "private": true,
  "description": "A reprogramming method to code better",
  "keywords": [
    "state machines",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "workspaces": [
    "packages/app",
    "packages/app-vitest"
  ],
  "type": "module",
  "scripts": {
    "vitest": "pnpm --filter='./packages/vitest'",
    "app": "pnpm --filter='./packages/app'",
    "project1": "pnpm --filter='./packages/__tests__/project1'",
    "solidjs": "pnpm --filter='./packages/solidjs'",
    "solidjs-vitest": "pnpm --filter='./packages/solidjs-vitest'",
    "build:app": "pnpm run app -- run build",
    "build:vitest": "pnpm run vitest -- run build",
    "build:solidjs": "pnpm run solidjs -- run build",
    "build:solidjs-vitest": "pnpm run solidjs-vitest -- run build",
    "build": "pnpm -r --sort run build",
    "config": "pnpm i",
    "rimraf": "pnpx rimraf",
    "rinit": "pnpm run rimraf ./node_modules ./pnpm-lock.yaml && pnpm run config",
    "lint:app": "pnpm run app -- run lint",
    "lint:vitest": "pnpm run vitest -- run lint",
    "lint:solidjs": "pnpm run solidjs -- run lint",
    "lint:solidjs-vitest": "pnpm run solidjs-vitest -- run lint",
    "lint": "pnpm run lint:app && pnpm run lint:vitest && pnpm run lint:solidjs && pnpm run lint:solidjs-vitest",
    "test:app": "pnpm run app -- run test",
    "test:vitest": "pnpm run vitest -- run test",
    "test:solidjs": "pnpm run solidjs -- run test",
    "test:solidjs-vitest": "pnpm run solidjs-vitest -- run test",
    "test:project1": "pnpm run project1 -- run test",
    "test": "pnpm run build && pnpm run test:app && pnpm run test:vitest && pnpm run test:solidjs && pnpm run test:solidjs-vitest && pnpm run test:project1",
    "pretest:app": "pnpm run app -- run pretest",
    "pretest:vitest": "pnpm run vitest -- run pretest",
    "pretest:solidjs": "pnpm run solidjs -- run pretest",
    "pretest:solidjs-vitest": "pnpm run solidjs-vitest -- run pretest",
    "pretest": "pnpm run pretest:app && pnpm run pretest:vitest && pnpm run pretest:solidjs && pnpm run pretest:solidjs-vitest",
    "posttest:app": "pnpm run app -- run posttest",
    "posttest:vitest": "pnpm run vitest -- run posttest",
    "posttest:solidjs": "pnpm run solidjs -- run posttest",
    "posttest:solidjs-vitest": "pnpm run solidjs-vitest -- run posttest",
    "posttest": "pnpm run posttest:app && pnpm run posttest:vitest && pnpm run posttest:solidjs && pnpm run posttest:solidjs-vitest",
    "test:only:app": "pnpm run app -- run test:only",
    "test:only:vitest": "pnpm run vitest -- run test:only",
    "test:only:solidjs": "pnpm run solidjs -- run test:only",
    "test:only:solidjs-vitest": "pnpm run solidjs-vitest -- run test:only",
    "test:only": "pnpm run test:only:app && pnpm run test:only:vitest && pnpm run test:only:solidjs && pnpm run test:only:solidjs-vitest",
    "ci:admin": "CI_ADMIN=$(date +%s) && pnpm run rm && pnpm run up && pnpm install && pnpm run -r build && pnpm run -r lint && pnpm run -r test:only && echo \"\n✅ Admin CI takes $(($(date +%s) - CI_ADMIN))s\n\"",
    "rm": "pnpx rimraf ./node_modules ./pnpm-lock.yaml",
    "up": "pnpm update --latest"
  },
  "devDependencies": {
    "@bemedev/better-promise": "^0.1.1",
    "@bemedev/better-set": "^0.2.1",
    "@bemedev/boolean-recursive": "^0.0.3",
    "@bemedev/decompose": "^2.2.0",
    "@bemedev/dev-utils": "^0.7.0",
    "@bemedev/interval2": "^1.0.1",
    "@bemedev/pipe": "^1.6.1",
    "@bemedev/rolldown-config": "^0.5.0",
    "@bemedev/rx-pausable": "^1.2.0",
    "@bemedev/scheduler": "^1.0.0",
    "@bemedev/sequence": "^1.0.0",
    "@bemedev/sleep": "^0.2.2",
    "@bemedev/typings": "^1.2.0",
    "@types/clone-deep": "^4.0.4",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "add": "^2.0.6",
    "clone-deep": "^4.0.1",
    "cmd-ts": "^0.15.0",
    "deepmerge-ts": "^7.1.5",
    "fast-deep-equal": "^3.1.3",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "is-online": "^12.0.2",
    "nanoid": "^5.1.11",
    "node-watch": "^0.7.4",
    "onchange": "^7.1.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "1.0.3",
    "rxjs": "^7.8.2",
    "ts-morph": "^28.0.0",
    "tsc-alias": "^1.8.17",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "valibot": "^1.4.1",
    "vitest": "^4.1.8",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
