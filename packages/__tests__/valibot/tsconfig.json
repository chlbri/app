{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "types": ["node", "vitest/globals"],
    "paths": {
      "#machines/helpers/*": ["../helpers/src/*"],
      "#machines/sync/*": ["../sync/src/*"],
      "#machines/async/*": ["../async/src/*"]
    }
  },
  "exclude": ["vitest.config.ts"]
}
