{
  "name": "@bemedev/interval3",
  "version": "1.0.0",
  "description": "A cancellable interval library with a recomputed delay on every pass.",
  "keywords": [
    "timer",
    "interval",
    "cancellable",
    "time",
    "sleep",
    "typescript"
  ],
  "homepage": "https://github.com/chlbri/app/blob/main/packages/interval3/README.md",
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./interval": {
      "import": "./lib/interval.js",
      "types": "./lib/interval.d.ts"
    },
    "./timer": {
      "import": "./lib/timer.js",
      "types": "./lib/timer.d.ts"
    },
    "./types": {
      "types": "./lib/types.types.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "p-q": "pretty-quick",
    "posttest": "vp fmt",
    "pretest": "vp run pack",
    "rm:lib": "vp dlx rimraf ./lib",
    "test:coverage": "vp test run",
    "test": "vp run test:coverage --no-coverage",
    "test:only": "vp run test",
    "test:watch": "vp test"
  },
  "peerDependencies": {
    "@bemedev/app-contract": "workspace:^"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "catalog:",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "pretty-quick": "catalog:",
    "rimraf": "catalog:",
    "size-limit": "catalog:",
    "tslib": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
