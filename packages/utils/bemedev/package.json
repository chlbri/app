{
  "name": "@bemedev/app-utils-bemedev",
  "version": "0.2.0",
  "private": false,
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "vp run rm:lib && vp run rolldown",
    "pretest": "vp run build",
    "_ci": "vp run lint && vp run test",
    "ci": "CI_START=$(date +%s) && vp run _ci && vp run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "_lint": "vp lint",
    "test": "vp run size && vp run fmt",
    "lint:fix": "vp lint --fix",
    "lint": "vp run fmt && vp run lint:fix",
    "p-q": "pretty-quick",
    "rm": "vp dlx rimraf ./node_modules ./pnpm-lock.yaml",
    "rm:lib": "vp dlx rimraf ./lib",
    "size": "size-limit",
    "rolldown": "rolldown -c"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "^1.5.0",
    "@bemedev/rolldown-config": "^0.5.0",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "1.2.15",
    "size-limit": "^14.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "size-limit": [
    {
      "path": "lib/*.js",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.cjs",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.d.ts",
      "limit": "10 KB"
    }
  ],
  "engines": {
    "node": ">=24"
  }
}
