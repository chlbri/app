{
  "name": "@bemedev/app-utils-bemedev",
  "version": "0.2.0",
  "private": false,
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "keywords": [],
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm rm:lib && pnpm run rolldown",
    "_ci": "pnpm run lint && pnpm run test",
    "ci": "CI_START=$(date +%s) && pnpm run _ci && pnpm run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "_lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "lint:watch": "onchange --await-write-finish 1500 -d 10000 -v \"**/*.ts\" -- pnpm run lint",
    "build:watch": "onchange --await-write-finish 1500 -d 10000 -v \"**/*.ts\" -- pnpm run build",
    "p-q": "pretty-quick",
    "posttest": "pnpm run fmt",
    "bemedev:lift": "pnpm dlx @bemedev/core lift",
    "prepublishOnly": "",
    "pretest": "pnpm run build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "rm:lib": "pnpx rimraf ./lib",
    "rolldown": "rolldown -c",
    "test:coverage": "vitest run --passWithNoTests",
    "test": "pnpm run test:coverage",
    "test:only": "pnpm run test:coverage --no-coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "^1.1.1",
    "@bemedev/rolldown-config": "^0.5.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "husky": "^9.1.7",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "1.2.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.11",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
