{
  "name": "@bemedev/app-cli",
  "version": "2.7.2",
  "private": false,
  "description": "CLI tool and AST parseTree parser for @bemedev/app",
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "bin": {
    "app-cli": "lib/bin.js"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "scripts": {
    "build": "vp run rm:lib && vp run rolldown && chmod +x lib/bin.js",
    "_ci": "vp run lint && vp run test",
    "ci": "CI_START=$(date +%s) && vp run _ci && vp run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "_lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint": "vp run fmt && vp run lint:fix",
    "p-q": "pretty-quick",
    "posttest": "vp run fmt",
    "pretest": "vp run build && vp run size",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "rm:lib": "vp dlx rimraf ./lib",
    "rolldown": "rolldown -c",
    "size": "size-limit",
    "test:coverage": "vp test run",
    "test": "vp run test:coverage --no-coverage",
    "test:only": "vp run test",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@bemedev/better-set": "^0.2.1",
    "@bemedev/decompose": "^2.3.0",
    "@bemedev/pipe": "^1.6.1",
    "@bemedev/sleep": "^0.2.2",
    "cmd-ts": "^0.15.0",
    "fast-glob": "^3.3.3",
    "node-watch": "^0.7.4",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@bemedev/app": "workspace:^",
    "@bemedev/dev-utils": "^1.5.0",
    "@bemedev/rolldown-config": "^0.5.0",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "catalog:",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "1.2.15",
    "size-limit": "^14.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@bemedev/app": "workspace:^"
  },
  "size-limit": [
    {
      "path": "lib/*.js",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.cjs",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.d.ts",
      "limit": "10 KB"
    }
  ],
  "engines": {
    "node": ">=24"
  }
}
