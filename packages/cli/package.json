{
  "name": "@bemedev/app-cli",
  "version": "3.1.0",
  "private": false,
  "description": "CLI tool and AST parseTree parser for @bemedev/app",
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "bin": {
    "app-cli": "lib/bin.js"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "scripts": {
    "p-q": "pretty-quick",
    "posttest": "vp fmt",
    "pretest": "vp run pack",
    "rm:lib": "vp dlx rimraf ./lib",
    "test:coverage": "vp test run",
    "test": "vp run test:coverage --no-coverage",
    "test:only": "vp run test",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@bemedev/better-set": "catalog:",
    "@bemedev/decompose": "catalog:",
    "@bemedev/pipe": "catalog:",
    "@bemedev/sleep": "catalog:",
    "cmd-ts": "catalog:",
    "fast-glob": "catalog:",
    "node-watch": "catalog:",
    "ts-morph": "catalog:"
  },
  "devDependencies": {
    "@bemedev/app": "workspace:^",
    "@bemedev/dev-utils": "catalog:",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
