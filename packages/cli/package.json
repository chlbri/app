{
  "name": "@bemedev/app-cli",
  "version": "1.11.1",
  "description": "CLI tool and AST parseTree parser for @bemedev/app",
  "private": false,
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "app-cli": "lib/bin.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm rm:lib && pnpm run rolldown && chmod +x lib/bin.js",
    "_ci": "pnpm run lint && pnpm run test",
    "ci": "CI_START=$(date +%s) && pnpm run _ci && pnpm run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "_lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "p-q": "pretty-quick",
    "posttest": "pnpm run fmt",
    "pretest": "pnpm run build && pnpm run size",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "rm:lib": "pnpx rimraf ./lib",
    "rolldown": "rolldown -c",
    "size": "size-limit",
    "test:coverage": "vitest run",
    "test": "pnpm run test:coverage --no-coverage",
    "test:only": "pnpm run test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bemedev/better-set": "^0.2.1",
    "@bemedev/decompose": "^2.3.0",
    "@bemedev/pipe": "^1.6.1",
    "@bemedev/sleep": "^0.2.2",
    "cmd-ts": "^0.15.0",
    "fast-glob": "^3.3.3",
    "node-watch": "^0.7.4",
    "ts-morph": "^28.0.0"
  },
  "peerDependencies": {
    "@bemedev/app": "workspace:^"
  },
  "devDependencies": {
    "@bemedev/app": "workspace:^",
    "@bemedev/dev-utils": "^1.2.0",
    "@bemedev/rolldown-config": "^0.5.0",
    "@size-limit/file": "^13.0.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "1.2.5",
    "size-limit": "^13.0.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "size-limit": [
    {
      "path": "lib/*.js",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.cjs",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.d.ts",
      "limit": "10 KB"
    }
  ]
}
