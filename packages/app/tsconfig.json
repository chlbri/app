{
  "compilerOptions": {
    "module": "esnext",
    "importHelpers": true,
    "target": "ESNext",
    "declaration": true,
    "sourceMap": true,
    "outDir": "./lib",
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "noErrorTruncation": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleResolution": "Bundler",
    "types": ["vitest/globals", "node"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "declarationMap": true,
    "paths": {
      "~types": ["./src/types/index.ts"],
      "#fixtures": ["./src/fixtures/index.ts"],
      "#common/*": ["./src/common/*"],
      "#exports/*": ["./src/exports/*"],
      "#fixturesData": [
        "./src/__tests__/interpreters/async/data/index.ts"
      ],
      "#sync/*": ["./src/sync/*"],
      "#utils": ["./src/utils/index.ts"],
      "#utils/*": ["./src/utils/*"],
      "#constants": ["./src/constants/index.ts"],
      "#children": ["./src/children/index.ts"],
      "#delays": ["./src/delays/index.ts"],
      "#actor": ["./src/actors/types.ts"],
      "#actors": ["./src/actors/index.ts"],
      "#states": ["./src/states/index.ts"],
      "#interpreters": ["./src/interpreters/index.ts"],
      "#interpreter": ["./src/interpreters/interpreter.ts"],
      "#guards": ["./src/guards/index.ts"],
      "#actions": ["./src/actions/index.ts"],
      "#events": ["./src/events/index.ts"],
      "#transitions": ["./src/transitions/index.ts"],
      "#emitters": ["./src/emitters/index.ts"],
      "#machine": ["./src/asyncMachine/machine.ts"],
      "#machines": ["./src/asyncMachine/index.ts"],
      "#registry": ["./src/registry.types.ts"],
      "#config": ["./src/config/index.ts"]
    }
  }
}
