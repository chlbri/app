{
  "name": "@bemedev/app",
  "version": "1.2.1",
  "description": "A reprogramming method to code better",
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "app-cli": "lib/cli/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "types": "./lib/index.d.ts"
    },
    "./utils": {
      "import": "./lib/utils/index.js",
      "require": "./lib/utils/index.cjs",
      "types": "./lib/utils/index.d.ts"
    },
    "./types": {
      "import": "./lib/types/index.js",
      "require": "./lib/types/index.cjs",
      "types": "./lib/types/index.d.ts"
    },
    "./bemedev": {
      "types": "./lib/bemedev.d.ts",
      "import": "./lib/bemedev.js",
      "require": "./lib/bemedev.cjs"
    },
    "./typings": {
      "import": "./lib/utils/typings.js",
      "require": "./lib/utils/typings.cjs",
      "types": "./lib/utils/typings.d.ts"
    },
    "./constants": {
      "import": "./lib/constants/index.js",
      "require": "./lib/constants/index.cjs",
      "types": "./lib/constants/index.d.ts"
    },
    "./states": {
      "import": "./lib/states/index.js",
      "require": "./lib/states/index.cjs",
      "types": "./lib/states/index.d.ts"
    },
    "./actions": {
      "import": "./lib/actions/index.js",
      "require": "./lib/actions/index.cjs",
      "types": "./lib/actions/index.d.ts"
    },
    "./guards": {
      "import": "./lib/guards/index.js",
      "require": "./lib/guards/index.cjs",
      "types": "./lib/guards/index.d.ts"
    },
    "./delays": {
      "import": "./lib/delays/index.js",
      "require": "./lib/delays/index.cjs",
      "types": "./lib/delays/index.d.ts"
    },
    "./emitters": {
      "import": "./lib/emitter/index.js",
      "require": "./lib/emitter/index.cjs",
      "types": "./lib/emitter/index.d.ts"
    },
    "./events": {
      "import": "./lib/events/index.js",
      "require": "./lib/events/index.cjs",
      "types": "./lib/events/index.d.ts"
    },
    "./transitions": {
      "import": "./lib/transitions/index.js",
      "require": "./lib/transitions/index.cjs",
      "types": "./lib/transitions/index.d.ts"
    },
    "./registry": {
      "import": "./lib/registry/index.js",
      "require": "./lib/registry/index.cjs",
      "types": "./lib/registry/index.d.ts"
    }
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "keywords": [
    "typescript",
    "state machines"
  ],
  "files": [
    "lib",
    "public"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm rm:lib && pnpm run rolldown",
    "_ci": "pnpm run lint && pnpm run test",
    "ci": "CI_START=$(date +%s) && pnpm run _ci && pnpm run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "ci:admin": "CI_START=$(date +%s) && pnpm run rm && pnpm run upgrade:fast && pnpm run _ci && echo \"\n✅ Admin CI takes $(($(date +%s) - CI_START))s\n\"",
    "config": "pnpm install",
    "config:off": "pnpm run config --offline",
    "generate:lib": "node lib/cli/index.js generate -c ./src/__tests__",
    "generate": "tsx src/cli/index.ts generate -c ./src/__tests__",
    "generate:watch": "tsx src/cli/index.ts watch -c ./src/__tests__",
    "_lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "lint:watch": "onchange --await-write-finish 1500 -d 10000 -v \"**/*.ts\" -- pnpm run lint",
    "build:watch": "onchange --await-write-finish 1500 -d 10000 -v \"**/*.ts\" -- pnpm run build",
    "p-q": "pretty-quick",
    "posttest": "pnpm run fmt",
    "prepublishOnly": "",
    "pretest": "pnpm run build && pnpm run generate:lib",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "rinit": "pnpm clean --lockfile && pnpm run rm && pnpm run config",
    "rinit:off": "pnpm run rm && pnpm run config:off",
    "rm": "pnpx rimraf ./node_modules ./pnpm-lock.yaml",
    "rm:lib": "pnpx rimraf ./lib",
    "rolldown": "rolldown -c",
    "test:coverage": "vitest run",
    "test": "pnpm run test:coverage",
    "test:only": "pnpm run test:coverage --no-coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "upgrade": "pnpm dlx @bemedev/upgrade-npm-package",
    "upgrade:fast": "pnpm up --latest"
  },
  "devDependencies": {
    "@bemedev/app-utils-bemedev": "workspace:^",
    "@bemedev/dev-utils": "^0.8.0",
    "@bemedev/rolldown-config": "^0.5.0",
    "@bemedev/rx-pausable": "^1.2.0",
    "@bemedev/sequence": "^1.0.0",
    "@types/clone-deep": "^4.0.4",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "add": "^2.0.6",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "is-online": "^12.0.2",
    "onchange": "^7.1.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "1.0.3",
    "rxjs": "^7.8.2",
    "tsc-alias": "^1.8.17",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zx": "^8.8.5"
  },
  "bundleDependencies": [
    "@bemedev/app-utils-bemedev"
  ],
  "dependencies": {
    "@bemedev/better-promise": "^0.1.1",
    "@bemedev/better-set": "^0.2.1",
    "@bemedev/boolean-recursive": "^0.0.3",
    "@bemedev/decompose": "^2.2.0",
    "@bemedev/interval2": "^1.0.1",
    "@bemedev/pipe": "^1.6.1",
    "@bemedev/scheduler": "^1.0.0",
    "@bemedev/sleep": "^0.2.2",
    "@bemedev/typings": "^1.2.0",
    "clone-deep": "^4.0.1",
    "cmd-ts": "^0.15.0",
    "deepmerge-ts": "^7.1.5",
    "fast-deep-equal": "^3.1.3",
    "fast-glob": "^3.3.3",
    "nanoid": "^5.1.11",
    "node-watch": "^0.7.4",
    "ts-morph": "^28.0.0",
    "valibot": "^1.4.1"
  }
}
