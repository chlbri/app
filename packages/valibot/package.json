{
  "name": "@bemedev/app-valibot",
  "version": "2.7.2",
  "description": "Valibot schemas and validation helpers for @bemedev/app",
  "keywords": [
    "state machines",
    "typescript",
    "valibot",
    "validation"
  ],
  "homepage": "https://github.com/chlbri/app/blob/main/packages/valibot/README.md",
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "types": "./lib/index.d.ts"
    }
  },
  "scripts": {
    "build": "vp run rm:lib && vp run rolldown",
    "_ci": "vp run lint && vp run test",
    "pretest": "vp run build",
    "ci": "CI_START=$(date +%s) && vp run _ci && vp run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "_lint": "vp lint",
    "test": "vp run size && vp run fmt",
    "lint:fix": "vp lint --fix",
    "lint": "vp run fmt && vp run lint:fix",
    "p-q": "pretty-quick",
    "rm": "vp dlx rimraf ./node_modules ./pnpm-lock.yaml",
    "rm:lib": "vp dlx rimraf ./lib",
    "size": "size-limit",
    "rolldown": "rolldown -c"
  },
  "dependencies": {
    "@bemedev/better-set": "^0.2.1",
    "@bemedev/typings": "^1.4.1"
  },
  "devDependencies": {
    "@bemedev/app": "workspace:^",
    "@bemedev/app-cli": "workspace:^",
    "@bemedev/dev-utils": "^1.5.0",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "1.2.15",
    "size-limit": "^14.3.0",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "valibot": "^1.5.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@bemedev/app": "workspace:^",
    "valibot": "^1.4.2"
  },
  "size-limit": [
    {
      "path": "lib/*.js",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.cjs",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.d.ts",
      "limit": "10 KB"
    }
  ],
  "engines": {
    "node": ">=24"
  }
}
