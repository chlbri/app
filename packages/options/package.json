{
  "name": "@bemedev/app-options",
  "version": "3.2.0",
  "description": "Contract-driven option helpers for @bemedev/app",
  "keywords": [
    "state machines",
    "options",
    "contracts",
    "typescript"
  ],
  "homepage": "https://github.com/chlbri/app/blob/main/packages/options/README.md",
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "types": "./lib/index.d.ts"
    },
    "./bemedev": {
      "import": "./lib/bemedev.js",
      "require": "./lib/bemedev.cjs",
      "types": "./lib/bemedev.d.ts"
    },
    "./better-promise": {
      "import": "./lib/better-promise.js",
      "require": "./lib/better-promise.cjs",
      "types": "./lib/better-promise.d.ts"
    },
    "./boolean-recursive": {
      "import": "./lib/boolean-recursive.js",
      "require": "./lib/boolean-recursive.cjs",
      "types": "./lib/boolean-recursive.d.ts"
    },
    "./contract": {
      "import": "./lib/contract.js",
      "require": "./lib/contract.cjs",
      "types": "./lib/contract.d.ts"
    },
    "./decompose": {
      "import": "./lib/decompose.js",
      "require": "./lib/decompose.cjs",
      "types": "./lib/decompose.d.ts"
    },
    "./internal": {
      "import": "./lib/internal/index.js",
      "require": "./lib/internal/index.cjs",
      "types": "./lib/internal/index.d.ts"
    },
    "./plugins": {
      "import": "./lib/plugins.js",
      "require": "./lib/plugins.cjs",
      "types": "./lib/plugins.d.ts"
    },
    "./types": {
      "import": "./lib/types.js",
      "require": "./lib/types.cjs",
      "types": "./lib/types.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "p-q": "pretty-quick",
    "posttest": "vp fmt",
    "pretest": "vp run pack",
    "publish:first": "vp run pretest && pnpm publish --access public --no-git-checks",
    "rm:lib": "vp dlx rimraf ./lib",
    "test:coverage": "vp test run",
    "test": "vp run test:coverage --no-coverage",
    "test:only": "vp run test",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@bemedev/app-plugins": "workspace:^",
    "@bemedev/better-promise": "catalog:",
    "@bemedev/boolean-recursive": "catalog:"
  },
  "peerDependencies": {
    "@bemedev/app-utils-bemedev": "workspace:^",
    "@bemedev/typings": "catalog:",
    "@bemedev/app-contract": "workspace:^",
    "@bemedev/decompose": "catalog:"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "catalog:",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "pretty-quick": "catalog:",
    "rimraf": "catalog:",
    "size-limit": "catalog:",
    "tslib": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
