{
  "name": "@bemedev/app-vitest",
  "version": "1.9.4",
  "description": "Test helpers for @bemedev/app",
  "private": false,
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "homepage": "https://github.com/chlbri/app/blob/main/packages/vitest/README.md",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "keywords": [
    "typescript",
    "state machines",
    "testing"
  ],
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm rm:lib && pnpm run rolldown",
    "_ci": "pnpm run lint && pnpm run build",
    "ci": "CI_START=$(date +%s) && pnpm run _ci && pnpm run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "_lint": "oxlint",
    "postbuild": "pnpm run size && pnpm run fmt",
    "lint:fix": "oxlint --fix",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "p-q": "pretty-quick",
    "rm": "pnpx rimraf ./node_modules ./pnpm-lock.yaml",
    "rm:lib": "pnpx rimraf ./lib",
    "size": "size-limit",
    "rolldown": "rolldown -c"
  },
  "devDependencies": {
    "@bemedev/app": "workspace:^",
    "@bemedev/app-cli": "workspace:^",
    "@bemedev/dev-utils": "^1.1.1",
    "@bemedev/rolldown-config": "^0.5.0",
    "@bemedev/sleep": "^0.2.2",
    "@bemedev/typings": "^1.3.0",
    "@size-limit/file": "^13.0.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "1.2.3",
    "size-limit": "^13.0.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "path": "lib/*.js",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.cjs",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.d.ts",
      "limit": "10 KB"
    }
  ],
  "peerDependencies": {
    "@bemedev/app": "workspace:^",
    "vitest": "^4.1.10"
  }
}
