{
  "name": "@bemedev/app-reactjs",
  "version": "1.11.0",
  "description": "Middleware between @bemedev/app and reactjs",
  "keywords": [
    "app",
    "bemedev",
    "middleware",
    "reactjs",
    "react",
    "state-machines"
  ],
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "homepage": "https://github.com/chlbri/app/blob/main/packages/reactjs/README.md",
  "files": [
    "lib",
    "public"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "pnpm rm:lib && pnpm run rolldown",
    "_ci": "pnpm run lint && pnpm run build",
    "ci": "CI_START=$(date +%s) && pnpm run _ci && pnpm run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "_lint": "oxlint",
    "postbuild": "pnpm run size && pnpm run fmt",
    "lint:fix": "oxlint --fix",
    "lint": "pnpm run fmt && pnpm run lint:fix",
    "p-q": "pretty-quick",
    "rm": "pnpx rimraf ./node_modules ./pnpm-lock.yaml",
    "rm:lib": "pnpx rimraf ./lib",
    "size": "size-limit",
    "rolldown": "rolldown -c"
  },
  "devDependencies": {
    "@bemedev/app": "workspace:^",
    "@bemedev/app-vitest": "workspace:^",
    "@bemedev/decompose": "2.3.0",
    "@bemedev/dev-utils": "^1.2.0",
    "@bemedev/sleep": "^0.2.2",
    "@size-limit/file": "^13.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "4.1.11",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "onchange": "^7.1.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "1.2.5",
    "rolldown-plugin-dts": "^0.28.2",
    "size-limit": "^13.0.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@bemedev/app": "workspace:^",
    "react": "^19.2.8"
  },
  "size-limit": [
    {
      "path": "lib/*.js",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.cjs",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.d.ts",
      "limit": "10 KB"
    }
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@bemedev/react-sync": "^0.1.1"
  }
}
