{
  "name": "@bemedev/app-reactjs",
  "version": "2.7.2",
  "description": "Middleware between @bemedev/app and reactjs",
  "keywords": [
    "app",
    "bemedev",
    "middleware",
    "react",
    "reactjs",
    "state-machines"
  ],
  "homepage": "https://github.com/chlbri/app/blob/main/packages/reactjs/README.md",
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "files": [
    "lib",
    "public"
  ],
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "vp run rm:lib && vp run rolldown",
    "_ci": "vp run lint && vp run build",
    "ci": "CI_START=$(date +%s) && vp run _ci && vp run p-q && echo \"\n✅ CI takes $(($(date +%s) - CI_START))s\n\"",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "_lint": "vp lint",
    "postbuild": "vp run size && vp run fmt",
    "pretest": "vp run build",
    "lint:fix": "vp lint --fix",
    "lint": "vp run fmt && vp run lint:fix",
    "p-q": "pretty-quick",
    "rm": "vp dlx rimraf ./node_modules ./pnpm-lock.yaml",
    "rm:lib": "vp dlx rimraf ./lib",
    "size": "size-limit",
    "rolldown": "rolldown -c"
  },
  "dependencies": {
    "@bemedev/react-sync": "^0.1.1"
  },
  "devDependencies": {
    "@bemedev/app": "workspace:^",
    "@bemedev/app-vitest": "workspace:^",
    "@bemedev/decompose": "2.3.0",
    "@bemedev/dev-utils": "^1.5.0",
    "@bemedev/sleep": "^0.2.2",
    "@size-limit/file": "^14.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "onchange": "^7.1.0",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "1.2.15",
    "rolldown-plugin-dts": "^0.28.8",
    "size-limit": "^14.3.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@bemedev/app": "workspace:^",
    "react": "^19.3.1"
  },
  "size-limit": [
    {
      "path": "lib/*.js",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.cjs",
      "limit": "10 KB"
    },
    {
      "path": "lib/*.d.ts",
      "limit": "10 KB"
    }
  ],
  "engines": {
    "node": ">=24"
  }
}
