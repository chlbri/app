{
  "name": "@bemedev/app-plugins",
  "version": "3.3.1",
  "description": "Utilities for @bemedev/app",
  "keywords": [
    "state machines",
    "utilities",
    "typescript"
  ],
  "homepage": "https://github.com/chlbri/app/blob/main/packages/plugins/core/README.md",
  "license": "MIT",
  "author": {
    "name": "chlbri",
    "email": "bri_lvi@icloud.com",
    "url": "https://bemedev.vercel.app"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/app"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    },
    "./types": {
      "types": "./lib/types.d.ts"
    },
    "./addons": {
      "import": "./lib/addons/index.js",
      "types": "./lib/addons/index.d.ts"
    },
    "./bemedev": {
      "import": "./lib/bemedev.js",
      "types": "./lib/bemedev.d.ts"
    },
    "./decompose": {
      "import": "./lib/decompose.js",
      "types": "./lib/decompose.d.ts"
    },
    "./internal": {
      "import": "./lib/internal/index.js",
      "types": "./lib/internal/index.d.ts"
    },
    "./same": {
      "import": "./lib/same.js",
      "types": "./lib/same.d.ts"
    },
    "./typings": {
      "import": "./lib/typings.js",
      "types": "./lib/typings.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "p-q": "pretty-quick",
    "posttest": "vp fmt",
    "pretest": "vp run pack",
    "rm:lib": "vp dlx rimraf ./lib",
    "publish:first": "vp run pretest && pnpm publish --access public --no-git-checks",
    "test:coverage": "vp test run",
    "test": "vp run test:coverage --no-coverage",
    "test:only": "vp run test",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@bemedev/app-contract": "workspace:^",
    "@bemedev/decompose": "catalog:"
  },
  "peerDependencies": {
    "@bemedev/typings": "catalog:"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "catalog:",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "pretty-quick": "catalog:",
    "rimraf": "catalog:",
    "size-limit": "catalog:",
    "tslib": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
