{
  "name": "@bemedev/app-solidjs-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "_prebuild": "vp run --filter @bemedev/app-utils-bemedev --filter @bemedev/app-contract --filter @bemedev/app-plugins --filter @bemedev/app-options --filter @bemedev/interval3 --filter @bemedev/app --filter @bemedev/app-cli --filter @bemedev/app-vitest pretest",
    "prebuild": "vp run _prebuild && vp run --filter @bemedev/app-solidjs pretest",
    "dev": "vp dev",
    "_build": "vp build",
    "build": "vp build",
    "_ci": "vp run _build && vp run test",
    "start": "vp start",
    "preview": "vp run build && vp start",
    "up": "vp update --latest",
    "test": "vp test run",
    "test:coverage": "vp test run",
    "test:watch": "vp test"
  },
  "dependencies": {
    "@bemedev/app": "workspace:^",
    "@bemedev/app-solidjs": "workspace:^",
    "@bemedev/decompose": "catalog:",
    "@solid-primitives/storage": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/solid-router": "catalog:",
    "@tanstack/solid-start": "catalog:",
    "clsx": "catalog:",
    "lucide-solid": "catalog:",
    "nitro": "catalog:",
    "solid-js": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "valibot": "catalog:",
    "vinxi": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@bemedev/dev-utils": "catalog:",
    "@tanstack/solid-router-devtools": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vite-plus": "catalog:",
    "vite-tsconfig-paths": "catalog:"
  }
}
