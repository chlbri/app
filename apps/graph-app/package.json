{
  "name": "graph-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "_prebuild": "vp run --filter @bemedev/app-utils-bemedev --filter @bemedev/app-contract --filter @bemedev/app-options --filter @bemedev/app pretest",
    "prebuild": "vp run _prebuild && vp run --filter @bemedev/app-reactjs pretest",
    "dev": "vp dev",
    "generate-routes": "tsr generate",
    "app:types": "app-cli generate -c ./src/services",
    "app:types:watch": "app-cli watch -c ./src/services",
    "build": "vp build",
    "preview": "vp preview"
  },
  "dependencies": {
    "@bemedev/app": "workspace:^",
    "@bemedev/app-reactjs": "workspace:^",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "nitro": "3.0.261103-rc",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reactflow": "11.11.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@bemedev/app-cli": "workspace:^",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
