{
  "name": "graph-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "_prebuild": "vp run --filter @bemedev/interval3 --filter @bemedev/app-utils-bemedev --filter @bemedev/app-contract --filter @bemedev/app-options --filter @bemedev/app pretest",
    "prebuild": "vp run _prebuild && vp run --filter @bemedev/app-reactjs pretest",
    "dev": "vp dev",
    "generate-routes": "tsr generate",
    "app:types": "app-cli generate -c ./src/services",
    "app:types:watch": "app-cli watch -c ./src/services",
    "build": "vp build",
    "preview": "vp preview"
  },
  "dependencies": {
    "@bemedev/app": "workspace:^",
    "@bemedev/app-reactjs": "workspace:^",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "nitro": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reactflow": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@bemedev/app-cli": "workspace:^",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
